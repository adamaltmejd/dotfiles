# Sandboxed coding-agent image for Apple `container` (one micro-VM per run).
#
# Network egress is NOT enforced here. It is enforced by the host-only
# `agentbox` network plus the allowlisting proxy on the host; see README.md.
#
# No Node and no npm, on the host or in this image: pi ships a standalone
# linux-arm64 binary. bun provides the JS runtime for project work instead.

FROM debian:trixie-slim

# Files written to /workspace must come back owned by the host user rather
# than the usual container 1000. agentbox.sh passes the real `id -u`/`id -g`;
# the defaults here only matter for a bare `container build`.
ARG BOX_UID=501
ARG BOX_GID=20

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Mirrors the tool defaults in ~/.config/CLAUDE.md so the agent can run the
# same checks we do. An agent that cannot verify its work only produces
# plausible-looking diffs.
# Build traffic goes through the host's allowlist proxy, the same one the
# running agent uses: the builder VM has no IPv6 route and intermittently
# fails to reach AAAA-first mirrors directly. ForceIPv4 covers a direct
# fallback if the proxy vars are ever unset.
ARG http_proxy
ARG https_proxy
RUN printf 'Acquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99force-ipv4 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip \
      git ripgrep fd-find jq tree \
      shellcheck shfmt \
      less nano procps iproute2 ncurses-term \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

# Binaries are fetched and checksum-verified on the host by `agentbox.sh
# vendor` (see vendor.lock), not downloaded here: the build VM's network is
# unreliable, and pinning by hash is worth more than pinning by version alone.
COPY vendor/ /tmp/vendor/

RUN set -eux; \
    # pi: standalone binary, no runtime dependency.
    tar -xzf /tmp/vendor/pi.tar.gz -C /opt; \
    ln -s /opt/pi/pi /usr/local/bin/pi; \
    # ast-grep: the archive also ships an `sg` shim, which collides with the
    # setgid binary -- extract only `ast-grep`.
    unzip -j /tmp/vendor/ast-grep.zip ast-grep -d /usr/local/bin; \
    tar -xzf /tmp/vendor/uv.tar.gz --strip-components=1 -C /usr/local/bin; \
    unzip -j /tmp/vendor/bun.zip '*/bun' -d /usr/local/bin; \
    ln -s /usr/local/bin/bun /usr/local/bin/bunx; \
    # rtk compresses noisy command output before the agent reads it. Installed
    # as a plain binary only: `rtk init` would add a hook that rewrites the
    # commands the agent runs, which is not something to enable by default.
    tar -xzf /tmp/vendor/rtk.tar.gz -C /usr/local/bin rtk; \
    chmod +x /usr/local/bin/rtk; \
    chmod +x /usr/local/bin/ast-grep /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/bun; \
    rm -rf /tmp/vendor

# The gid may not exist in Debian (macOS staff=20 collides with dialout, other
# hosts may have no group at all), so create one when it is missing.
RUN getent group "${BOX_GID}" >/dev/null || groupadd --gid "${BOX_GID}" box \
 && useradd --uid "${BOX_UID}" --gid "${BOX_GID}" --create-home --shell /bin/bash box

USER box
WORKDIR /workspace

# The bind mount's own inode reports as root-owned inside the VM even though
# its contents are the host user's, so git refuses the repo as "dubious
# ownership". Only ever one project is mounted here, and the user chose it.
RUN git config --global --add safe.directory /workspace

# pi reads ~/.pi/agent/* at runtime; agentbox.sh mounts it there.
ENV HOME=/home/box \
    PI_SKIP_VERSION_CHECK=1 \
    RTK_TELEMETRY_DISABLED=1
ENTRYPOINT ["pi"]
