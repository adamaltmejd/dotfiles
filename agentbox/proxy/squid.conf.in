# Template. agentbox.sh substitutes @VAR@ and writes the result to the state
# directory; do not point squid at this file directly.

http_port @PORT@

# Only the container networks may use this proxy. Binding to 0.0.0.0 is
# necessary because the vmnet gateway address is not a bindable host
# interface, so this ACL is what stops it being an open relay on the LAN.
# @BUILD_SUBNET@ is the default NAT network the image builder runs on;
# @SUBNET@ is the host-only network the agent itself runs on.
acl boxnet src @SUBNET@ @BUILD_SUBNET@ 127.0.0.1/32

acl allowed dstdomain "@FILTER@"
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT

http_access deny !boxnet
# Port restrictions must cover both request shapes. CONNECT is limited to 443,
# but a plain proxied GET names its own port and is NOT a CONNECT -- without
# Safe_ports squid will happily fetch http://allowed-host:22/ on the agent's
# behalf. Deny everything outside 80/443 before the allow rule.
http_access deny CONNECT !SSL_ports
http_access deny !Safe_ports
http_access allow boxnet allowed
http_access deny all

# A proxy, not a cache: never store what the agent fetches.
cache deny all

# The audit trail for everything the agent talked to.
access_log stdio:@ACCESSLOG@
cache_log @CACHELOG@
pid_filename @PIDFILE@

# Do not leak the container's address or advertise the proxy upstream.
forwarded_for delete
via off

dns_v4_first on
shutdown_lifetime 1 second
