cask_args appdir: "/Applications"

# Build tools and compilers
brew "gcc"
brew "cmake"
brew "llvm"
brew "pkg-config"
brew "openblas"
brew "libomp"
# SSH FIDO2 support (runtime dependency for sk-libfido2.dylib)
brew "libfido2"

# Shell and CLI
brew "antidote"
brew "shellcheck"
brew "shfmt"
brew "tlrc"
brew "delta"
brew "tmux"
brew "terminal-notifier"
brew "pinentry-mac"
brew "mole"
# g-prefixed GNU tools; setup.sh links only gtimeout -> ~/.local/bin/timeout
brew "coreutils"

# Version control
brew "git-lfs"
brew "git-filter-repo"
brew "gh"

# Languages
brew "python3"
brew "uv"
brew "oven-sh/bun/bun"

# Documents
brew "pandoc"

# Libraries for R compilation
brew "libtiff"
brew "libpng"
brew "jpeg-turbo"
brew "freetype"
brew "openssl"
brew "mbedtls"
brew "zstd"

# Apple's container runtime, used by pinfold (github.com/adamaltmejd/pinfold)
# to run coding agents in disposable micro-VMs.
brew "container"

# Casks
cask "1password-cli"
cask "1password"
cask "dropbox"
cask "alfred"
cask "ghostty"
cask "little-snitch"
cask "visual-studio-code"
cask "visual-studio-code@insiders"
cask "hazel"
cask "zoom"
cask "slack"
cask "notion"
cask "microsoft-office"
cask "r-app"
cask "mactex-no-gui"
