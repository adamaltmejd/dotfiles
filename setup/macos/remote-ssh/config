# Stable Tailscale identities allowed to reach SSH. Each record is:
#   public-key name | Tailscale DNS name | expected Tailscale OS
#
# The installer resolves current 100.x addresses from `tailscale status`,
# excludes the server itself, and binds every key to its device's source IP.
REMOTE_SSH_CLIENTS=(
    "iphone|iphone-15-pro.boga-hadar.ts.net.|iOS"
    "macbook|macbook.boga-hadar.ts.net.|macOS"
    "macmini|macmini.boga-hadar.ts.net.|macOS"
)
