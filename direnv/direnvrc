# use_op — resolve 1Password secrets
#
# Usage in .envrc:
#   use op ~/.config/zsh/secrets/base.env        # bulk: inject a dotenv template (cached)
#   use op MY_SECRET op://vault/item/field       # single: read one secret (not cached)
#   use op --lazy MY_SECRET op://vault/item/field   # single ref, on-demand use (never cached)
#   use op --lazy ~/.config/zsh/secrets/prod.env    # bulk template, on-demand use (never cached)
#
# Template format (dotenv, not shell):
#   KEY=op://vault/item/field
#
# Cached forms write resolved values to $XDG_CACHE_HOME/direnv-op/ keyed on the
# template's absolute path. Cache invalidates when the template's mtime
# changes. To force refresh after rotating a secret in 1Password:
#   touch <template>   OR   rm -rf ${XDG_CACHE_HOME:-$HOME/.cache}/direnv-op/
#
# --lazy is the opposite: nothing is resolved at load time and nothing is cached.
# It only records each reference (an inline NAME/ref pair or a template path) in
# declaration order in $OP_RUN_LAZY, which two consumers parse: the `oprun`
# shell function (zsh/conf.d/secrets.zsh) injects the secrets via `op run` at
# exec time, and op_lazy_load() (r/Rprofile) sets them in an R session.
# 1Password prompts when you actually run the command, not on cd. The real value
# never enters your shell env, so a plain run (without oprun) sees the var unset.
# If a key is registered more than once, the last --lazy declaration wins.

# Absolutize a template path and verify it is a readable file; prints the abspath.
_op_template_path() {
    local tpl
    tpl="$(cd "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")"
    if [[ ! -f "$tpl" || ! -r "$tpl" ]]; then
        log_error "use_op: template not a readable file: $1"
        return 1
    fi
    printf '%s' "$tpl"
}

use_op() {
    if ! has op; then
        log_error "use_op: op (1Password CLI) not found"
        return 1
    fi

    if [[ "$1" == "--lazy" ]]; then
        local nl=$'\n' tab=$'\t'
        # Inline form: use op --lazy NAME op://vault/item/field
        if [[ $# -eq 3 ]]; then
            local name="$2" ref="$3"
            if [[ ! "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                log_error "use op --lazy: invalid env var name: $name"
                return 1
            fi
            if [[ "$ref" != op://* ]]; then
                log_error "use op --lazy: reference must start with op:// — got: $ref"
                return 1
            fi
            export OP_RUN_LAZY="${OP_RUN_LAZY:+$OP_RUN_LAZY$nl}r${tab}$name=$ref"
            log_status "registered lazy secret $name — run via: oprun <cmd>"
            return
        fi
        # Template form: use op --lazy <path>
        if [[ $# -ne 2 ]]; then
            log_error "use op --lazy: expected NAME REF or a single template path"
            return 1
        fi
        local tpl
        tpl="$(_op_template_path "$2")" || return 1
        export OP_RUN_LAZY="${OP_RUN_LAZY:+$OP_RUN_LAZY$nl}f${tab}$tpl"
        watch_file "$tpl"
        log_status "registered lazy secrets $(user_rel_path "$tpl") — run via: oprun <cmd>"
        return
    fi

    if [[ $# -eq 2 ]]; then
        local name="$1" ref="$2"
        local val
        if ! val=$(op read "$ref" 2>/dev/null); then
            log_error "use_op: failed to read $ref"
            return 1
        fi
        export "$name=$val"
        return
    fi

    local tpl="${1:?use_op requires a template path or NAME REF}"
    tpl="$(_op_template_path "$tpl")" || return 1

    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv-op"
    mkdir -p "$cache_dir"

    local cache_key
    cache_key=$(printf '%s' "$tpl" | shasum -a 256 | cut -d' ' -f1)
    local cache_file="$cache_dir/$cache_key"

    if [[ ! -f "$cache_file" || "$tpl" -nt "$cache_file" ]]; then
        log_status "resolving secrets from $(user_rel_path "$tpl")"
        if ! op inject --in-file "$tpl" > "$cache_file" 2>/dev/null; then
            rm -f "$cache_file"
            log_error "use_op: op inject failed for $tpl"
            return 1
        fi
        chmod 600 "$cache_file"
    fi

    dotenv "$cache_file"
    watch_file "$tpl"
}
