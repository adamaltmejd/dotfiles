# Whitelist approach: ignore everything, then explicitly track what we want
*

# Root files
!.gitignore
!README.md
!CLAUDE.md

# Zsh configuration
!zsh/
!zsh/**

# Git+Github configuration
!git/
!git/**
!gh/
!gh/**

# SSH configuration
!ssh/
!ssh/**

# R configuration (explicit files only; XDG-aware packages write here too)
!r/
!r/Rprofile
!r/Renviron
!r/Makevars
!r/lintr

# Radian (R console)
!radian/
!radian/**

# Ansible
!ansible/
!ansible/**

# Ghostty
!ghostty/
!ghostty/**

# AI agents (Claude Code, Codex CLI, shared skills)
!agents/
!agents/**
!.claude/
!.claude/**
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/settings.local.json
# Codex owns and rewrites config.toml at runtime (trust levels, marketplaces,
# desktop/tui state, machine paths) — untracked to avoid churn. See setup.sh.
agents/codex/config.toml
# agents/skills/ is allowlisted: installed marketplace skills (large, churn on
# update) are ignored; curated skills are re-allowed explicitly below.
agents/skills/*
!agents/skills/web-design-reviewer/
!agents/skills/web-design-reviewer/**

# uv (Python)
!uv/
!uv/uv.toml

# Bun (JS)
!.bunfig.toml

# Direnv
!direnv/
!direnv/**

# Zellij
!zellij/
!zellij/**

# Setup internals and docs
!setup/
!setup/**

# Ignore generated/local files within tracked dirs
setup/profile
zsh/plugins.zsh
zsh/.zcompdump*
zsh/local.zsh
zsh/secrets/local.zsh
git/config.local
git/config.macos
gh/hosts.yml
r/fixest/
r/modelsummary/

# Common junk
.DS_Store
.Rhistory
*.swp
*~
*.bak

# Ignore local/sensitive files
*.local

# == Explicit ignores ==
op
mole
b2
cagent
.wrangler
homebrew
opentofu
