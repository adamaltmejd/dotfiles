# Common settings for all homelab hosts. `User root` is the LXC default;
# the PVE and VM blocks above override it via first-match-wins.
# Also defaults direct 100.x device access to these settings.
Host adguard-sthlm adguard2-sthlm certbot-sthlm ha-sthlm hermes-sthlm logging-sthlm media-sthlm mqtt-sthlm n8n-sthlm pbs-sthlm recorder-sthlm sure uptime-sthlm zigbee2mqtt-sthlm adguard-breven ha-breven logging-breven matter-breven mqtt-breven pbs-breven recorder-breven uptime-breven watermeter-breven zigbee2mqtt-breven pve-sthlm pve1-sthlm pve2-sthlm pve1-breven *.home.altmejd.se 10.?.40.* 10.?.50.* 100.*
    User root
    Port 22
    IdentityFile ~/.ssh/id_home
    PasswordAuthentication no
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts_homelab
    LogLevel ERROR
    # Servers use the default C.UTF-8 locale; override the locale the macOS
    # client forwards (SendEnv LANG LC_*) so bash's setlocale doesn't warn.
    SetEnv LANG=C.UTF-8 LC_ALL=C.UTF-8

# Unifi Gateways
Host 10.0.0.1 10.1.0.1
    User root
    IdentityFile ~/.ssh/id_home

Host rutx50.*
    User root
    IdentityFile ~/.ssh/id_home

Host rutx50.internal
