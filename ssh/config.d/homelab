# Bare short names → FQDN (e.g. `ssh pve-sthlm` → pve-sthlm.home.altmejd.se).
# Canonicalization re-matches every Host block below against the FQDN, so
# `User`, `IdentityFile`, etc. apply correctly. The FQDN resolves via the
# Tailscale split-DNS rule for home.altmejd.se → AdGuard → LAN IP, so on-LAN
# traffic stays on LAN and off-LAN traffic uses the Tailscale subnet routers.
Host *-sthlm *-breven
    CanonicalizeHostname yes
    CanonicalDomains home.altmejd.se
    CanonicalizeMaxDots 0

# PVE nodes — interactive login as root (password), Ansible as ansible (key)
Host pve-sthlm.home.altmejd.se pve1-breven.home.altmejd.se 10.0.50.2 10.1.50.2
    PasswordAuthentication yes

# Common settings for all homelab hosts. `User root` is the LXC default;
# the PVE and VM blocks above override it via first-match-wins.
# Also defaults all Tailscale devices to these settings.
Host *.home.altmejd.se 10.?.40.* 10.?.50.* 100.*
    User root
    Port 22
    IdentityFile ~/.ssh/id_home
    PasswordAuthentication no
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts_homelab
    LogLevel ERROR
    # Servers use the default C.UTF-8 locale; override the locale the macOS
    # client forwards (SendEnv LANG LC_*) so bash's setlocale doesn't warn.
    SetEnv LANG=C.UTF-8 LC_ALL=C.UTF-8

# Unifi Gateways
Host 10.0.0.1 10.1.0.1
    User root
    IdentityFile ~/.ssh/id_home

Host rutx50.*
    User root
    IdentityFile ~/.ssh/id_home

Host rutx50.internal
    HostName 192.168.100.1

Host rutx50.ts
    HostName rutx50.boga-hadar.ts.net
